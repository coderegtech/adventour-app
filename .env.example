# Browser-safe project settings (use a dedicated development project).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side development seeding ONLY. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Must exactly match NEXT_PUBLIC_SUPABASE_URL and belong to a disposable dev/test project.
SEED_ALLOWED_URL=
SEED_CONFIRM_DEVELOPMENT=no
# Choose a unique strong password for the demo accounts (minimum 12 characters).
SEED_USER_PASSWORD=
